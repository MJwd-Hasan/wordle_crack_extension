{
  "manifest_version": 3,
  "name": "Wordle Guesser — Manual Player",
  "version": "2.0.0",
  "description": "Wordle helper with a larger dictionary and entropy-ranked suggestions.",
  "permissions": [],
  "host_permissions": [
    "https://wordlearchive.org/*",
    "https://www.wordlearchive.org/*",
    "https://*.nytimes.com/games/wordle/*",
    "https://lookleft.github.io/wordle-history/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wordle Guesser"
  },
  "content_scripts": [
    {
      "matches": [
        "https://wordlearchive.org/*",
        "https://www.wordlearchive.org/*",
        "https://*.nytimes.com/games/wordle/*",
        "https://lookleft.github.io/wordle-history/*"
      ],
      "js": [
        "words.js",
        "engine.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
